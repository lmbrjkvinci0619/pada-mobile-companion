}

export async function fetchTeams(signal?: AbortSignal): Promise<Team[]> {
  if (USE_ MOCK_ DATA) return MOCK_TEAMS;

  const cached = getCached<Team[]>("teams");
  if (cached) return cached;

  const data = await topscoreGet<any[]>(
    "/api/teams?fields=locations,roster,record",
    signal
  );
  const teams = data.map((t) => ({
    id: String(t.id),
    name: t.name,
    division: t.division,
    sport: t.sport ?? "Ultimate Frisbee",
    season: t.season,
    logoUrl: t.logo_ url,
    color: t.color,
    wins: t.record?.wins,
    losses: t.record?.losses,
    ties: t.record?.ties,
    roster: mapRoster(t.roster),
  }));

  setCache("teams", teams, CACHE_ TTL.teams);
  return teams;
}

export async function fetchTeam(
  teamId: string,
  signal?: AbortSignal
): Promise<Team | undefined> {
  if (USE_ MOCK_ DATA) return MOCK_TEAMS.find((t) => t.id === teamId);

  const cacheKey = `team_${teamId}`;
  const cached = getCached<Team>(cacheKey);
  if (cached) return cached;

  const data = await topscoreGet<any>(
    `/api/teams/${teamId}?fields=roster,locations,record`,
    signal
  );
  const team: Team = {
    id: String(data.id),
    name: data.name,
    division: data.division,
    sport: data.sport ?? "Ultimate Frisbee",
    season: data.season,
    wins: data.record?.wins,
    losses: data.record?.losses,
    ties: data.record?.ties,
    roster: mapRoster(data.roster),
  };

  setCache(cacheKey, team, CACHE_ TTL.teams);
  return team;
}

export async function fetchEvents(teamId?: string, signal?: AbortSignal): Promise<Event[]> {
  const cacheKey = teamId ? `events_${teamId}` : "events_ all";

  if (USE_ MOCK_ DATA) {
    return teamId
      ? MOCK_EVENTS. filter((e) => e.teamId === teamId)
      : MOCK_EVENTS;
  }

  const cached = getCached<Event[]>(cacheKey);
  if (cached) return cached;

  const path = teamId
    ? `/api/events?team_ id=${teamId}&fields=locations,scores`
    : `/api/events?fields=locations,scores`;
  const data = await topscoreGet<any[]>(path, signal);

  const events = data.map((e) => ({
    id: String(e.id),
    type: e.type ?? "game",
    status: e.status ?? "scheduled",
    title: e.name ?? e.title,
    startDate: e.start_ date,
    endDate: e.end_ date,
    teamId: String(e.team_ id),
    teamName: e.team_ name ?? "",
    opponentName: e.opponent_ name,
    location: e.location
      ? {
          id: String(e.location.id),
          name: e.location.name,
          address: e.location.address,
          city: e.location.city,
          state: e.location.state,
          zip: e.location.zip,
          latitude: e.location.latitude,
          longitude: e.location.longitude,
        }
      : undefined,
    notes: e.notes,
    score: e.score
      ? {
          homeTeamName: e.team_ name ?? "Home",
          awayTeamName: e.opponent_ name ?? "Away",
          homeScore: e.score.home_ score ?? 0,
          awayScore: e.score.away_ score ?? 0,
          reportedAt: e.score.reported_ at,
        }
      : undefined,
  }));

  setCache(cacheKey, events, CACHE_ TTL.schedule);
  return events;
}

