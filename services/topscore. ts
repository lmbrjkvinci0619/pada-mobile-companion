  USE_ MOCK_ DATA,
  MOCK_ USER,
  MOCK_REGISTRATIONS,
  MOCK_TEAMS,
  MOCK_EVENTS,
} from "@/constants/mockData";

interface PendingRequest {
  promise: Promise<unknown>;
  timestamp: number;
}

const pendingRequests = new Map<string, PendingRequest>();
const PENDING_REQUEST_TTL = 30000;

setInterval(() => {
  const now = Date. now();
  for (const [key, req] of pendingRequests) {
    if (now - req.timestamp > PENDING_REQUEST_TTL) {
      pendingRequests.delete(key);
    }
  }
}, 10000);

async function topscoreGet<T>(path: string, signal?: AbortSignal): Promise<T> {
  if (USE_ MOCK_ DATA) {
    throw new Error("USE_MOCK_ DATA: should not reach topscoreGet");
  }

  const existing = pendingRequests. get(path);
  if (existing && Date. now() - existing.timestamp < PENDING_REQUEST_TTL) {
    return existing.promise as Promise<T>;
  }

  const token = await getValidAccessToken();
  if (!token) throw new Error("Not authenticated");
  if (signal?.aborted) throw new Error("Aborted");

  const controller = new AbortController();
  if (signal) {
    signal. addEventListener("abort", () => controller. abort());
  }

  const promise = (async () => {
    const res = await fetch(`${TOPSCORE_BASE_URL}${path}`, {
      headers: { Authorization: `Bearer ${token}` },
      signal: controller.signal,
    });

    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error((err as any).message ?? `API error ${res.status}`);
    }

    return res.json() as Promise<T>;
  })();

  pendingRequests. set(path, { promise, timestamp: Date. now() });
  return promise;
}

export async function fetchCurrentUser(signal?: AbortSignal): Promise<User> {
  if (USE_ MOCK_ DATA) return MOCK_ USER;

  const cached = getCached<User>("currentUser");
  if (cached) return cached;

  const data = await topscoreGet<any>("/api/persons/me", signal);
  const user: User = {
    id: String(data.id),
    firstName: data.first_ name,
    lastName: data.last_ name,
    email: data.email,
    avatarUrl: data.avatar_ url,
    role: data.role ?? "player",
  };

  setCache("currentUser", user, CACHE_ TTL.userProfile);
  return user;
}

