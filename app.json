{
  "expo": {
    "name": "PadaHub",
    "slug": "pada-buddy",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "padahub",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.pada.padahub",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "org.pada.padahub",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1E88E5",
          "sounds": []
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow PadaHub to access your calendar to export game schedules."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 2000,
      "checkAutomatically": "NEVER"
    },
    "extra": {
      "eas": {
        "projectId": "203ec5d8-6e91-42ec-b644-3c2dc7165d04"
      }
    }
  }
}
