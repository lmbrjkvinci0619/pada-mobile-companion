# TopScore API Credentials
# Used for OAuth2 password grant authentication
EXPO_PUBLIC_TOPSCORE_CLIENT_ID=your_topscore_client_id
EXPO_PUBLIC_TOPSCORE_CLIENT_SECRET=your_topscore_client_secret
EXPO_PUBLIC_TOPSCORE_BASE_URL=https://pada.usetopscore.com

# OAuth2 Mode (default: true when CLIENT_ID is set)
# Set to "false" only if using Basic Auth with CSRF signatures instead of OAuth2.
# When true: Uses Bearer token in Authorization header (recommended per TopScore API spec)
# When false: Uses auth_token + api_csrf query parameters for Basic Auth
# EXPO_PUBLIC_TOPSCORE_USE_OAUTH2=true

# Supabase Credentials
# Used for announcements, live scores, and push notifications
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-jwt-anon-key
